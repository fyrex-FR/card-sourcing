{
  "name": "card-alerter",
  "version": "2.0.0",
  "private": true,
  "description": "Alerteur eBay sur Telegram pour cartes NBA",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build web",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "dev:web": "vite web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "2.0.2",
    "@hono/node-server": "2.1.1",
    "drizzle-orm": "0.45.4",
    "grammy": "1.46.0",
    "hono": "4.13.9",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tanstack/react-query": "5.103.2",
    "@types/node": "24.19.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
